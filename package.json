{
  "name": "zercle-bun-template",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "dev": "bun run --watch src/main.ts",
    "start": "bun run src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src test",
    "lint:fix": "biome check --write src test",
    "format": "biome format --write src test",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:coverage": "vitest run --project unit --coverage",
    "migrate:generate": "drizzle-kit generate",
    "migrate:up": "bun run src/migrate.ts up",
    "migrate:down": "bun run src/migrate.ts down",
    "migrate:status": "bun run src/migrate.ts status",
    "docker:build": "docker build -f Containerfile -t zercle-bun-template:latest ."
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.221.0",
    "@opentelemetry/instrumentation": "0.222.0",
    "@opentelemetry/instrumentation-http": "0.221.0",
    "@opentelemetry/propagator-jaeger": "^2.10.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-node": "0.221.0",
    "@opentelemetry/sdk-trace-base": "2.10.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "drizzle-orm": "0.45.2",
    "esbuild": "^0.25.12",
    "hono": "4.13.5",
    "ioredis": "6.0.0",
    "nanoid": "^3.3.18",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "postcss": "^8.5.26",
    "postgres": "3.4.9",
    "prom-client": "15.1.3",
    "protobufjs": "^7.6.6",
    "yaml": "2.9.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/bun": "1.4.0",
    "@vitest/coverage-v8": "4.1.11",
    "drizzle-kit": "0.31.10",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "@opentelemetry/propagator-jaeger": "^2.9.0",
    "protobufjs": "^7.6.5",
    "nanoid": "^3.3.16",
    "postcss": "^8.5.23",
    "esbuild": "^0.25.0"
  }
}
