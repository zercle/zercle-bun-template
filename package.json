{
  "name": "zercle-bun-template",
  "version": "1.0.0",
  "description": "Production-ready RESTful API template built with Bun runtime and Hono framework",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/main.ts",
    "start": "bun run src/main.ts",
    "build": "bun build src/main.ts --outdir ./dist",
    "test": "bun test",
    "test:integration": "bun test --envfile .env.test tests/integration/",
    "test:coverage": "bun test --coverage",
    "test:db:start": "podman-compose -f deployments/docker/docker-compose.test.yml up -d",
    "test:db:stop": "podman-compose -f deployments/docker/docker-compose.test.yml down -v",
    "test:db:migrate": "bunx drizzle-kit migrate --config drizzle.config.ts",
    "test:db:health": "bun tests/integration/setup.ts --health-check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "bunx drizzle-kit generate",
    "db:push": "bunx drizzle-kit push",
    "db:studio": "bunx drizzle-kit studio",
    "db:migrate": "bunx drizzle-kit migrate"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.7",
    "@hono/zod-validator": "^0.7.6",
    "argon2": "^0.44.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.11.3",
    "js-yaml": "^4.1.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "postgres": "^3.4.7",
    "uuid": "^13.0.0",
    "zod": "^4.3.4"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.0.3",
    "@types/pg": "^8.16.0",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "bun-types": "^1.3.5",
    "drizzle-kit": "^0.31.8",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.51.0"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "overrides": {
    "esbuild": ">=0.25.0"
  }
}
