{
  "name": "zercle-bun-template",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "dev": "bun run --watch src/main.ts",
    "start": "bun run src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src test",
    "lint:fix": "biome check --write src test",
    "format": "biome format --write src test",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:coverage": "vitest run --project unit --coverage",
    "migrate:generate": "drizzle-kit generate --schema=./src/features/$FEATURE/repository/postgres/schema.ts --out=./src/features/$FEATURE/repository/postgres/migrations",
    "migrate:up": "bun run src/migrate.ts up",
    "migrate:down": "bun run src/migrate.ts down",
    "migrate:status": "bun run src/migrate.ts status",
    "docker:build": "docker build -f Containerfile -t zercle-bun-template:latest ."
  },
  "dependencies": {
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.300.0",
    "@opentelemetry/instrumentation": "0.300.0",
    "@opentelemetry/instrumentation-http": "0.300.0",
    "@opentelemetry/resources": "3.0.0",
    "@opentelemetry/sdk-node": "0.300.0",
    "@opentelemetry/sdk-trace": "3.0.0",
    "@opentelemetry/semantic-conventions": "1.44.0",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.16",
    "ioredis": "6.0.0",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0",
    "postgres": "4.0.0",
    "prom-client": "15.1.3",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/bun": "1.4.4",
    "@vitest/coverage-v8": "5.1.0",
    "drizzle-kit": "0.31.11",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "overrides": {
    "esbuild": "^0.25.12",
    "fast-copy": "^4.3.1",
    "source-map-js": "^1.2.2",
    "vite": "^8.3.5"
  }
}
